// Database cho shop-fe. Doi provider sang "postgresql"/"mysql" + DATABASE_URL
// khi can trien khai that, Prisma khong doi model.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum CreatedBy {
  WEB
  CHATBOT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum Audience {
  MEN
  WOMEN
  KIDS
  UNISEX
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  phone         String?
  role          Role     @default(CUSTOMER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  orders        Order[]
  reviews       Review[]
  reviewReplies ReviewReply[]
  carts         Cart[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  /** Nhom hien thi tren menu (VD "Ao", "Quan", "Vay & Dam", "Phu kien") —
   * null = chua xep nhom, hien o muc "Khac" trong dropdown. */
  group     String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  basePrice    Int
  description  String?
  brand        String?
  material     String?
  sizeChartUrl String?
  audience     Audience @default(UNISEX)
  viewCount    Int      @default(0)
  /** Nhan vien an san pham (VD het hang lau dai) — van con du lieu don cu, chi
   * khong hien trong tim kiem/danh sach cong khai nua. */
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  images       ProductImage[]
  variants     Variant[]
  reviews      Review[]
  orderItems   OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  /** Null = anh chung cho san pham. Co gia tri = chi hien khi khach chon mau nay. */
  color     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
}

model Variant {
  id            Int     @id @default(autoincrement())
  productId     Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique
  size          String
  color         String
  colorHex      String?
  priceOverride Int?
  stockQty      Int     @default(0)

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id])
  sessionId String?   @unique
  createdAt DateTime  @default(now())
  items     CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

model ShippingMethod {
  id      Int     @id @default(autoincrement())
  name    String
  fee     Int
  etaDays String
  active  Boolean @default(true)
  orders  Order[]
}

model DiscountCode {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  type           DiscountType
  value          Int
  minOrderAmount Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  orders         Order[]
}

model Order {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  userId           Int?
  user             User?           @relation(fields: [userId], references: [id])
  sessionId        String?
  status           OrderStatus     @default(PENDING)
  subtotal         Int
  shippingFee      Int
  discountAmount   Int             @default(0)
  totalAmount      Int
  paymentMethod    PaymentMethod
  shippingMethodId Int?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  discountCodeId   Int?
  discountCode     DiscountCode?   @relation(fields: [discountCodeId], references: [id])
  receiverName     String
  receiverPhone    String
  /** Email nhan thong bao don hang — null cho don cu truoc khi co tinh nang nay. */
  email            String?
  shippingAddress  String
  note             String?
  createdBy        CreatedBy       @default(WEB)
  createdAt        DateTime        @default(now())
  cancelledAt      DateTime?
  cancelReason     String?

  items            OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  variantId   Int
  variant     Variant @relation(fields: [variantId], references: [id])
  productName String
  size        String
  color       String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
}

model Review {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  rating    Int
  content   String
  createdAt DateTime     @default(now())
  reply     ReviewReply?

  @@unique([productId, userId])
}

model ReviewReply {
  id         Int      @id @default(autoincrement())
  reviewId   Int      @unique
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   User     @relation(fields: [employeeId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}
