DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/shop?schema=public"
JWT_SECRET="doi-chuoi-nay-o-production"
JWT_EXPIRES_IN="7d"
PORT=8080
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:8080"
MAX_UPLOAD_MB=10

# Gui mail xac nhan don hang (Gmail App Password, khong phai mat khau Gmail thuong)
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# Cloudflare R2 (luu anh san pham) — de trong het thi fallback ve dia cuc bo (chi
# dung cho dev; Render se xoa dia moi lan deploy lai nen production BAT BUOC can R2).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Dung de sinh redirectUrl/ipnUrl cho MoMo — doi lai dung domain that khi deploy.
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:8080"

# MoMo (vi dien tu) — de trong thi dung bo tai khoan TEST cong khai cua MoMo (chi
# de thu nghiem). Dang ky sandbox rieng mien phi tai business.momo.vn neu can.
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT=""

# PayOS (chuyen khoan ngan hang, tu dong xac nhan qua webhook) — de trong thi
# "Chuyen khoan ngan hang" fallback ve VietQR tinh + nhan vien tu xac nhan tay.
# Dang ky mien phi tai https://payos.vn de lay 3 khoa nay.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# Tai khoan admin dau tien (tu tao luc khoi dong server; de trong = khong tao)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Gui mail qua Brevo (HTTPS) — can thiet tren Render mien phi (SMTP bi chan)
BREVO_API_KEY=""
EMAIL_SENDER=""
